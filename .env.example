# ==============================================================================
# Darb REST - Root Environment Configuration Example
# ==============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-key

# Platform
NEXT_PUBLIC_PLATFORM_DOMAIN=rest.darb.co.il
NODE_ENV=development

# Optional public web origin for customer links from the admin app
# NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Payments: disabled online unless a supported server-side adapter is selected.
# local-test is rejected in production and against remote Supabase.
# PAYMENT_PROVIDER=local-test
# PAYMENT_TEST_WEBHOOK_SECRET=<random local secret, minimum 32 characters>
# Future live provider checkout redirect origins (HTTPS, comma-separated)
# PAYMENT_REDIRECT_ORIGINS=https://checkout.your-provider.example

# Production public origin: required at build/deployment time (HTTPS, no path).
# NEXT_PUBLIC_WEB_URL=https://your-public-domain.example
# Public mutation budgets require an ingress-owned single IP header, stripped from client input.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
# PUBLIC_RATE_LIMIT_SECRET=<random server-only secret, minimum 32 characters>

# Production administrative origin (HTTPS, no path).
# NEXT_PUBLIC_ADMIN_URL=https://your-admin-domain.example
